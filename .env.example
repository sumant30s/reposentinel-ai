# Copy with scripts/bootstrap.py to generate a strong local token. Never commit .env.
RS_API_TOKEN=
RS_DEMO_MODE=false
RS_DATABASE_URL=sqlite:///./data/reposentinel.db
RS_DATA_DIR=data
RS_SAMPLE_DIR=sample_projects/vulnerable
RS_FRONTEND_DIR=frontend/dist
# Comma-separated exact GitHub owner/repository names; empty disables GitHub intake in web UI.
RS_ALLOWED_REPOS=
RS_OSV_ENABLED=true
RS_ENGINES=bandit,detect-secrets,semgrep,pip-audit
RS_AI_PROVIDER=none
RS_AI_MODEL=
RS_AI_API_KEY=
RS_AI_BASE_URL=https://api.openai.com/v1
RS_OLLAMA_URL=http://127.0.0.1:11434
RS_EXPOSURE=internal
RS_CRITICAL_ASSET=false
RS_SCAN_TIMEOUT=180
RS_ENGINE_TIMEOUT=30
# Docker Compose database secret is generated by bootstrap.py.
POSTGRES_PASSWORD=
