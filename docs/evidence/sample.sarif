  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "RepoSentinel AI",
          "version": "0.1.0",
          "rules": [
            {
              "id": "RS002",
              "shortDescription": {
                "text": "Hard-coded credential"
              },
              "help": {
                "text": "Remove the credential, rotate it if real, and load it from a secret manager or environment."
              }
            },
            {
              "id": "RS003",
              "shortDescription": {
                "text": "Dynamic code execution"
              },
              "help": {
                "text": "Use a strict parser such as json.loads and a fixed set of allowed operations."
              }
            },
            {
              "id": "RS001",
              "shortDescription": {
                "text": "Dynamic SQL query"
              },
              "help": {
                "text": "Use driver placeholders and pass values separately; allowlist SQL identifiers."
              }
            },
            {
              "id": "RS004",
              "shortDescription": {
                "text": "Potential unsafe deserialization"
              },
              "help": {
                "text": "Avoid pickle for untrusted data. Use JSON with schema validation."
              }
            },
            {
              "id": "RS005",
              "shortDescription": {
                "text": "Shell command execution"
              },
              "help": {
                "text": "Pass an argument list with shell=False, validate inputs, and use a fixed executable."
              }
            },
            {
              "id": "RS007",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "help": {
                "text": "Enable certificate validation and configure the correct CA trust store."
              }
            },
            {
              "id": "RS008",
              "shortDescription": {
                "text": "Debug configuration enabled"
              },
              "help": {
                "text": "Disable debug mode in production and keep detailed errors out of public responses."
              }
            },
            {
              "id": "RS006",
              "shortDescription": {
                "text": "Weak cryptographic hash"
              },
              "help": {
                "text": "Use modern purpose-appropriate cryptography; use Argon2/bcrypt for passwords, not a fast hash."
              }
            }
          ]
        }
      },
